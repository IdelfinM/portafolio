---
import CaseView from '../../../views/CaseView.astro';
import { slugOf } from '../../../i18n/ui';
import { getCases } from '../../../lib/content';

export async function getStaticPaths() {
  const cases = await getCases('en');
  return cases.map((entry) => ({ params: { slug: slugOf(entry.id) }, props: { entry } }));
}

const { entry } = Astro.props;
---

<CaseView lang="en" entry={entry} />
