---
import { render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import StackBadge from '../components/StackBadge.astro';
import { caseUrl, projectUrl, routes, slugOf, useT, type Lang } from '../i18n/ui';
import { getProjects, projectTitles } from '../lib/content';

interface Props {
  lang: Lang;
  entry: CollectionEntry<'cases'>;
}
const { lang, entry } = Astro.props;
const t = useT(lang);
const other: Lang = lang === 'es' ? 'en' : 'es';
const d = entry.data;
const { Content } = await render(entry);
const projectTitle = projectTitles(await getProjects(lang)).get(d.project);
---

<Base lang={lang} title={d.title} description={d.summary} altUrl={caseUrl(other, slugOf(entry.id))}>
  <article class="container-page max-w-3xl py-14">
    <a href={routes.cases[lang]} class="mb-8 inline-flex items-center gap-1 text-sm link-accent">
      <Icon name="arrowRight" class="size-4 rotate-180" />
      {t('case.back')}
    </a>
    <header class="mb-10">
      {
        projectTitle && (
          <p class="mb-3 text-xs font-semibold tracking-wider uppercase">
            <span class="text-slate-500 dark:text-slate-400">{t('case.project')}:</span>{' '}
            <a href={projectUrl(lang, d.project)} class="text-accent-700 hover:underline dark:text-accent-300">
              {projectTitle}
            </a>
          </p>
        )
      }
      <h1 class="mb-4 text-3xl leading-tight font-bold tracking-tight sm:text-5xl">{d.title}</h1>
      <span class="mb-5 block h-1 w-16 rounded-full bg-linear-to-r from-accent-400 to-accent-200" aria-hidden="true"></span>
      <p class="mb-5 text-lg leading-relaxed text-slate-600 dark:text-slate-300">{d.summary}</p>
      <div class="flex flex-wrap gap-1.5">{d.tags.map((tag) => <StackBadge label={tag} />)}</div>
    </header>

    <div class="card mb-12 flex gap-4 border-l-4 border-l-accent-400 p-6">
      <span class="icon-chip size-10">
        <Icon name="check" class="size-5" />
      </span>
      <p>
        <span class="block font-display font-semibold">{t('case.result')}</span>
        <span class="text-slate-700 dark:text-slate-300">{d.result}</span>
      </p>
    </div>

    <div
      class="prose max-w-none prose-slate dark:prose-invert prose-headings:font-display prose-headings:tracking-tight prose-h2:mt-12 prose-h2:border-l-4 prose-h2:border-accent-400 prose-h2:pl-3 prose-a:text-accent-700 prose-code:rounded prose-code:bg-slate-100 prose-code:px-1 prose-code:py-0.5 prose-code:before:content-none prose-code:after:content-none dark:prose-a:text-accent-300 dark:prose-code:bg-slate-800"
    >
      <Content />
    </div>
  </article>
</Base>
