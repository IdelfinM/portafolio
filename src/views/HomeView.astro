---
import { existsSync } from 'node:fs';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CaseCard from '../components/CaseCard.astro';
import Contact from '../components/Contact.astro';
import Icon from '../components/Icon.astro';
import SectionTitle from '../components/SectionTitle.astro';
import { site } from '../config/site';
import { stackGroups } from '../config/stack';
import { routes, splitHighlight, useT, withBase, type Lang } from '../i18n/ui';
import { getCases, getProjects, projectTitles, techCasesUrl, totalTests } from '../lib/content';
import { techInfo } from '../config/tech';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const other: Lang = lang === 'es' ? 'en' : 'es';

const projects = await getProjects(lang);
const featured = projects.filter((p) => p.data.featured);
const allCases = await getCases(lang);
const cases = allCases.filter((c) => c.data.featured).slice(0, 4);
const titles = projectTitles(projects);
const casesFor = await techCasesUrl(lang);
// El boton del CV solo aparece cuando el PDF existe de verdad en public/.
const hasCv = existsSync(`public${site.cv[lang]}`);

// Cifras de la portada sacadas del contenido, no escritas a mano: si cambia un proyecto, cambian
// solas. Las pruebas se redondean hacia abajo a la centena para no prometer de mas.
const tests = totalTests(projects);
const nf = new Intl.NumberFormat(lang === 'es' ? 'es-DO' : 'en-US');
const stats = [
  { icon: 'flask', value: `${nf.format(Math.floor(tests / 100) * 100)}+`, label: t('hero.stats.tests') },
  { icon: 'folder', value: String(projects.length), label: t('hero.stats.projects') },
  { icon: 'bulb', value: String(allCases.length), label: t('hero.stats.cases') },
] as const;
const role = splitHighlight(lang === 'es' ? 'Ingeniero de Software [Full-Stack]' : '[Full-Stack] Software Engineer');
---

<Base lang={lang} altUrl={routes.home[other]}>
  <section class="container-page pt-20 pb-16 text-center sm:pt-28">
    <p class="mb-5 inline-flex items-center gap-2 rounded-full border border-accent-200 bg-accent-50 px-4 py-1.5 text-sm font-medium text-accent-700 dark:border-accent-400/30 dark:bg-accent-400/10 dark:text-accent-300">
      <span class="size-2 rounded-full bg-accent-400"></span>
      {site.location[lang]}
    </p>
    <h1 class="mx-auto mb-4 max-w-4xl text-5xl leading-tight font-bold tracking-tight sm:text-7xl">{site.name}</h1>
    <p class="mb-6 font-display text-2xl font-semibold sm:text-3xl">
      {role.map((p) => (p.highlight ? <span class="text-gradient">{p.text}</span> : p.text))}
    </p>
    <p class="mx-auto mb-10 max-w-2xl text-lg text-slate-600 dark:text-slate-300">{t('hero.pitch')}</p>
    <div class="flex flex-wrap justify-center gap-3">
      <a href={routes.projects[lang]} class="btn-primary">
        {t('hero.cta.projects')}
        <Icon name="arrowRight" class="size-4" />
      </a>
      {
        hasCv && (
          <a href={withBase(site.cv[lang])} download class="btn-secondary">
            <Icon name="download" class="size-4" />
            {t('hero.cta.cv')}
          </a>
        )
      }
      <a href="#contacto" class="btn-secondary">
        <Icon name="mail" class="size-4" />
        {t('hero.cta.contact')}
      </a>
    </div>

    <dl class="mx-auto mt-16 grid max-w-3xl grid-cols-3 gap-6">
      {
        stats.map((s) => (
          <div class="flex flex-col items-center">
            <dd class="order-2 font-display text-3xl font-bold sm:text-4xl"><span class="text-gradient">{s.value}</span></dd>
            <dt class="order-3 mt-1 text-sm text-slate-600 dark:text-slate-400">{s.label}</dt>
            <Icon name={s.icon} class="order-1 mb-2 size-6 text-accent-500" />
          </div>
        ))
      }
    </dl>
  </section>

  <section class="container-page py-16" aria-labelledby="destacados">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <SectionTitle id="destacados" text={t('home.featured')} />
      <a href={routes.projects[lang]} class="mb-8 inline-flex items-center gap-1 link-accent">
        {t('home.featured.all')}
        <Icon name="arrowRight" class="size-4" />
      </a>
    </div>
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {featured.map((p) => <ProjectCard lang={lang} project={p} />)}
    </div>
  </section>

  <section class="bg-slate-50 py-20 dark:bg-slate-900/40" aria-labelledby="casos">
    <div class="container-page">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <SectionTitle id="casos" text={t('home.cases')} />
        <a href={routes.cases[lang]} class="mb-8 inline-flex items-center gap-1 link-accent">
          {t('home.cases.all')}
          <Icon name="arrowRight" class="size-4" />
        </a>
      </div>
      <p class="-mt-2 mb-10 max-w-2xl text-lg text-slate-600 dark:text-slate-400">{t('home.cases.intro')}</p>
      <div class="grid gap-6 md:grid-cols-2">
        {cases.map((c) => <CaseCard lang={lang} entry={c} projectTitle={titles.get(c.data.project)} />)}
      </div>
    </div>
  </section>

  <section class="container-page py-20" aria-labelledby="stack">
    <SectionTitle id="stack" text={t('home.stack')} />
    <p class="-mt-2 mb-10 max-w-2xl text-lg text-slate-600 dark:text-slate-400">{t('home.stack.intro')}</p>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        stackGroups.map((g) => (
          <article class="card card-hover p-6">
            <div class="mb-4 flex items-center gap-3">
              <span class="icon-chip">
                <Icon name={g.icon} class="size-6" />
              </span>
              <h3 class="text-lg font-semibold">{g.label[lang]}</h3>
            </div>
            <ul class="space-y-1.5 text-sm text-slate-600 dark:text-slate-300">
              {g.items.map((item) => {
                const label = typeof item === 'string' ? item : item[lang];
                const icon = techInfo(label).icon;
                const href = casesFor(label);
                return (
                  <li class="flex items-center gap-2">
                    {icon ? (
                      <svg viewBox="0 0 24 24" class="size-4 shrink-0 text-slate-500 dark:text-slate-400" fill="currentColor" aria-hidden="true">
                        <path d={icon.path} />
                      </svg>
                    ) : (
                      <span class="mx-[0.3125rem] size-1.5 shrink-0 rounded-full bg-accent-400" aria-hidden="true" />
                    )}
                    {href ? (
                      <a href={href} class="underline decoration-accent-400 decoration-2 underline-offset-4 hover:text-accent-700 dark:hover:text-accent-300">
                        {label}
                      </a>
                    ) : (
                      label
                    )}
                  </li>
                );
              })}
            </ul>
          </article>
        ))
      }
    </div>
  </section>

  <Contact lang={lang} />
</Base>
