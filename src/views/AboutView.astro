---
import Base from '../layouts/Base.astro';
import Contact from '../components/Contact.astro';
import SectionTitle from '../components/SectionTitle.astro';
import { routes, useT, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const other: Lang = lang === 'es' ? 'en' : 'es';
---

<Base lang={lang} title={t('about.title')} altUrl={routes.about[other]}>
  <section class="container-page max-w-3xl py-16">
    <SectionTitle as="h1" text={t('about.title')} />
    <div
      class="prose max-w-none prose-lg prose-slate dark:prose-invert prose-headings:font-display prose-headings:tracking-tight prose-h2:border-l-4 prose-h2:border-accent-400 prose-h2:pl-3 prose-a:text-accent-700 prose-strong:text-slate-900 prose-li:marker:text-accent-500 dark:prose-a:text-accent-300 dark:prose-strong:text-white"
    >
      <slot />
    </div>
  </section>
  <Contact lang={lang} />
</Base>
