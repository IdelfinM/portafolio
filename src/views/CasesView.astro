---
import Base from '../layouts/Base.astro';
import CaseCard from '../components/CaseCard.astro';
import SectionTitle from '../components/SectionTitle.astro';
import { plain, routes, useT, withBase, type Lang } from '../i18n/ui';
import { getCases, getProjects, projectTitles, tagsByFrequency } from '../lib/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const other: Lang = lang === 'es' ? 'en' : 'es';
const cases = await getCases(lang);
const titles = projectTitles(await getProjects(lang));
const tags = tagsByFrequency(cases);
---

<Base lang={lang} title={t('cases.title')} altUrl={routes.cases[other]}>
  <section class="container-page py-16">
    <SectionTitle as="h1" text={t('cases.title')} />
    <p class="-mt-2 mb-10 max-w-2xl text-lg text-slate-600 dark:text-slate-400">{t('cases.intro')}</p>

    {/* El filtro llega oculto y lo muestra filtro-casos.js: sin JS se ve la lista completa. */}
    <div id="filtro-casos" class="mb-10 hidden flex-wrap gap-2" role="group" aria-label={plain(t('cases.title'))}>
      <button type="button" data-tag="" aria-pressed="true" class="filtro">{t('cases.filter.all')}</button>
      {
        tags.map((tag) => (
          <button type="button" data-tag={tag} aria-pressed="false" class="filtro">
            {tag}
          </button>
        ))
      }
    </div>

    <div id="lista-casos" class="grid gap-6 md:grid-cols-2">
      {cases.map((c) => <CaseCard lang={lang} entry={c} projectTitle={titles.get(c.data.project)} />)}
    </div>
  </section>
  {/* Fichero propio y no <script> procesado: la CSP del sitio es script-src 'self' sin inline. */}
  <script is:inline src={withBase('/js/filtro-casos.js')} defer></script>
</Base>

<style>
  @reference "../styles/global.css";

  .filtro {
    @apply cursor-pointer rounded-full border border-slate-200 bg-white px-4 py-1.5 text-sm font-medium text-slate-700 transition hover:border-accent-400 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300;
  }
  .filtro[aria-pressed='true'] {
    @apply border-accent-400 bg-accent-400 text-slate-950 shadow-sm;
  }
</style>
