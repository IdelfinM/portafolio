---
import { render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import CaseCard from '../components/CaseCard.astro';
import Icon from '../components/Icon.astro';
import SectionTitle from '../components/SectionTitle.astro';
import StackBadge from '../components/StackBadge.astro';
import StatusBadge from '../components/StatusBadge.astro';
import { projectUrl, routes, slugOf, useT, withBase, type Lang } from '../i18n/ui';
import { getCases } from '../lib/content';

interface Props {
  lang: Lang;
  project: CollectionEntry<'projects'>;
}
const { lang, project } = Astro.props;
const t = useT(lang);
const other: Lang = lang === 'es' ? 'en' : 'es';
const slug = slugOf(project.id);
const d = project.data;
const { Content } = await render(project);
const cases = (await getCases(lang)).filter((c) => c.data.project === slug);
---

<Base lang={lang} title={d.title} description={d.summary} altUrl={projectUrl(other, slug)}>
  <article class="container-page py-14">
    <a href={routes.projects[lang]} class="mb-8 inline-flex items-center gap-1 text-sm link-accent">
      <Icon name="arrowRight" class="size-4 rotate-180" />
      {t('project.back')}
    </a>
    <header class="mb-12">
      <div class="mb-4 flex flex-wrap items-center gap-3">
        <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">{d.title}</h1>
        <StatusBadge lang={lang} status={d.status} />
      </div>
      <span class="mb-5 block h-1 w-16 rounded-full bg-linear-to-r from-accent-400 to-accent-200" aria-hidden="true"></span>
      <p class="max-w-3xl text-lg leading-relaxed text-slate-600 dark:text-slate-300">{d.summary}</p>
      {
        (d.role || d.period) && (
          <p class="mt-4 text-sm font-medium text-slate-500 dark:text-slate-400">
            {[d.role, d.period].filter(Boolean).join(' · ')}
          </p>
        )
      }
      {d.confidential && <p class="mt-5 rounded-xl bg-slate-100 px-4 py-3 text-sm dark:bg-slate-900">{t('project.confidential')}</p>}
    </header>

    {
      d.image && (
        <img src={withBase(d.image)} alt={d.imageAlt ?? ''} class="card mb-12 w-full" loading="eager" />
      )
    }

    <div class="grid gap-10 lg:grid-cols-[1fr_18rem]">
      <div>
        <SectionTitle text={t('project.highlights')} />
        <ul class="mb-10 space-y-3">
          {
            d.highlights.map((h) => (
              <li class="flex gap-3">
                <span class="mt-0.5 grid size-5 shrink-0 place-items-center rounded-full bg-accent-400 text-slate-950">
                  <Icon name="check" class="size-3" />
                </span>
                <span class="text-slate-700 dark:text-slate-300">{h}</span>
              </li>
            ))
          }
        </ul>
        <div class="prose max-w-none prose-slate dark:prose-invert prose-headings:font-display prose-headings:tracking-tight prose-a:text-accent-700 dark:prose-a:text-accent-300">
          <Content />
        </div>
      </div>

      <aside class="space-y-6">
        {
          d.metrics.length > 0 && (
            <section class="card p-6">
              <h2 class="mb-4 text-sm font-semibold tracking-wider text-slate-500 uppercase dark:text-slate-400">{t('project.metrics')}</h2>
              <dl class="space-y-4">
                {d.metrics.map((m) => (
                  <div>
                    <dd class="font-display text-3xl font-bold text-accent-700 dark:text-accent-400">{m.value}</dd>
                    <dt class="text-sm text-slate-600 dark:text-slate-400">{m.label}</dt>
                  </div>
                ))}
              </dl>
            </section>
          )
        }
        <section class="card p-6">
          <h2 class="mb-4 text-sm font-semibold tracking-wider text-slate-500 uppercase dark:text-slate-400">{t('project.stack')}</h2>
          <div class="flex flex-wrap gap-1.5">{d.stack.map((s) => <StackBadge label={s} />)}</div>
        </section>
        {
          (d.links.length > 0 || d.demoOnRequest) && (
            <section class="card p-6">
              <h2 class="mb-4 text-sm font-semibold tracking-wider text-slate-500 uppercase dark:text-slate-400">{t('project.links')}</h2>
              <ul class="space-y-2 text-sm">
                {d.links.map((l) => (
                  <li>
                    <a href={l.href} class="link-accent">{l.label} ↗</a>
                  </li>
                ))}
                {d.demoOnRequest && <li class="text-slate-600 dark:text-slate-400">{t('project.demo')}</li>}
              </ul>
            </section>
          )
        }
      </aside>
    </div>

    {
      cases.length > 0 && (
        <section class="mt-20">
          <SectionTitle text={t('project.cases')} />
          <div class="grid gap-6 md:grid-cols-2">
            {cases.map((c) => (
              <CaseCard lang={lang} entry={c} />
            ))}
          </div>
        </section>
      )
    }
  </article>
</Base>
