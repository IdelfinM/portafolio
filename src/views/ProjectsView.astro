---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionTitle from '../components/SectionTitle.astro';
import { routes, useT, type Lang } from '../i18n/ui';
import { getProjects } from '../lib/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const other: Lang = lang === 'es' ? 'en' : 'es';
const projects = await getProjects(lang);
---

<Base lang={lang} title={t('projects.title')} altUrl={routes.projects[other]}>
  <section class="container-page py-16">
    <SectionTitle as="h1" text={t('projects.title')} />
    <p class="-mt-2 mb-12 max-w-2xl text-lg text-slate-600 dark:text-slate-400">{t('projects.intro')}</p>
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {projects.map((p) => <ProjectCard lang={lang} project={p} />)}
    </div>
  </section>
</Base>
