---
import type { CollectionEntry } from 'astro:content';
import { caseUrl, slugOf, useT, type Lang } from '../i18n/ui';
import StackBadge from './StackBadge.astro';

interface Props {
  lang: Lang;
  entry: CollectionEntry<'cases'>;
  projectTitle?: string;
}
const { lang, entry, projectTitle } = Astro.props;
const t = useT(lang);
const { title, summary, result, tags } = entry.data;
---

<article
  class="relative flex flex-col rounded-xl border border-slate-200 p-5 transition hover:border-accent-400 dark:border-slate-800 dark:hover:border-accent-600"
  data-tags={tags.join('|')}
>
  {projectTitle && <p class="mb-1 text-xs font-medium tracking-wide text-accent-700 uppercase dark:text-accent-300">{projectTitle}</p>}
  <h3 class="mb-2 font-semibold tracking-tight">
    <a href={caseUrl(lang, slugOf(entry.id))} class="after:absolute after:inset-0">{title}</a>
  </h3>
  <p class="mb-3 text-sm text-slate-600 dark:text-slate-400">{summary}</p>
  <p class="mb-4 border-l-2 border-accent-500 pl-3 text-sm">
    <span class="font-medium">{t('case.result')}:</span>{' '}
    {result}
  </p>
  <div class="mt-auto flex flex-wrap gap-1.5">
    {tags.map((tag) => <StackBadge label={tag} />)}
  </div>
</article>
