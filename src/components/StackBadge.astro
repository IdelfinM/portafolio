---
import { techInfo } from '../config/tech';

interface Props {
  label: string;
  // Con href la etiqueta lleva a los desafios de esa tecnologia. No usarlo dentro de una tarjeta que
  // ya es un enlace: un <a> dentro de otro no es HTML valido.
  href?: string;
}
const { label, href } = Astro.props;
const { icon } = techInfo(label);
const Tag = href ? 'a' : 'span';
---

<Tag
  href={href}
  class:list={[
    'inline-flex items-center gap-1.5 rounded-md bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-700 dark:bg-slate-800 dark:text-slate-300',
    href && 'ring-1 ring-accent-400 transition hover:bg-accent-400 hover:text-slate-950 dark:hover:bg-accent-400 dark:hover:text-slate-950',
  ]}
>
  {
    icon && (
      <svg viewBox="0 0 24 24" class="size-3.5 shrink-0" fill="currentColor" aria-hidden="true">
        <path d={icon.path} />
      </svg>
    )
  }
  {label}
</Tag>
